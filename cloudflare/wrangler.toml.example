# 模糊音克星 · Cloudflare Worker 配置（模板）
# 使用：复制本文件为同目录 wrangler.toml（已 gitignore，不入版本库），
#       并把 wrangler kv namespace create FPF_SYNC 输出的 id 填到下方
# 部署：npm install wrangler → wrangler login → 创建 KV → wrangler deploy
name = "fuzzy-pinyin-fixer-sync"
main = "index.js"
compatibility_date = "2024-11-01"

# 生产环境 KV 绑定（变量名 FPF_SYNC 与 index.js 中 env.FPF_SYNC 对应）
[[kv_namespaces]]
binding = "FPF_SYNC"
# 在此填写你的 KV 命名空间 ID（wrangler kv namespace create 的输出）
id = "你的_KV_命名空间_ID"
